# ==============================================================================
# Hyperliquid Testnet Account Credentials (Template)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env   (or Copy-Item .env.example .env in PowerShell)
# 2. Fill in your master account address and API Agent private key.
# ==============================================================================

# 1. Master Account Address (Your MetaMask / Rabby wallet address connected to app.hyperliquid-testnet.xyz)
HYPERLIQUID_ACCOUNT_ADDRESS=0xYourAccountAddressHere

# 2. API Agent Private Key (Generated from https://app.hyperliquid-testnet.xyz/agents)
#    Or Master Wallet Private Key (API Agent is recommended for security!)
HYPERLIQUID_SECRET_KEY=0xYourPrivateKeyHere

# 3. Network selection (true = Testnet, false = Mainnet)
HYPERLIQUID_TESTNET=true
